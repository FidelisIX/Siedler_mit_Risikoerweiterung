  "production": {
    "rules": [
      { "id": "R-PROD-01", "text": "Alle Landfelder mit Zahlenchip = Würfelsumme produzieren." },
      { "id": "R-PROD-02", "text": "Pro angrenzender Siedlung 1, pro angrenzender Stadt 2 Karten; gilt für alle Spieler.", "yield": { "settlement": 1, "city": 2 } },
      { "id": "R-PROD-03", "text": "Feld mit Räuber produziert nicht." },
      { "id": "R-PROD-04", "text": "Reicht der Vorrat eines Rohstoffs nicht für alle, erhält niemand diesen Rohstoff; ist nur ein Spieler betroffen, erhält er den Rest.", "sources": ["Q1", "Q2"] }
    ],
    "sources": ["Q1", "Q3"]
  },

  "seven_rolled": {
    "rules": [
      { "id": "R-SEVEN-01", "text": "Kein Feld produziert." },
      { "id": "R-SEVEN-02", "text": "Jeder Spieler mit mehr als 7 Rohstoffkarten wirft floor(n/2) Karten seiner Wahl ab.", "hand_limit": 7, "discard": "floor(n/2)", "dev_cards_count": false },
      { "id": "R-SEVEN-03", "text": "Aktiver Spieler MUSS den Räuber auf ein anderes Landfeld versetzen.", "must_change_hex": true, "desert_allowed": true, "desert_allowed_note": "GAP-04" },
      { "id": "R-SEVEN-04", "text": "1 zufällige Rohstoffkarte von einem Mitspieler mit Gebäude am Zielfeld rauben; bei mehreren wählt der aktive Spieler.", "victim": "opponent_with_building_on_hex", "card": "random_resource" },
      { "id": "R-SEVEN-05", "text": "Danach weiter mit der Aktionsphase." }
    ],
    "sources": ["Q1", "Q3", "Q4"]
  },

  "trade": {
    "rules": [
      { "id": "R-TRADE-01", "text": "Nur der aktive Spieler handelt; Mitspieler nur mit ihm, nicht untereinander." },
      { "id": "R-TRADE-02", "text": "Binnenhandel: Konditionen frei verhandelbar." },
      { "id": "R-TRADE-03", "text": "Kein Verschenken (0:n), kein Tausch gleicher Rohstoffe." },
      { "id": "R-TRADE-04", "text": "Entwicklungskarten nicht handelbar/verschenkbar." },
      { "id": "R-TRADE-05", "text": "Seehandel 4:1 ohne Hafen.", "ratio": 4 },
      { "id": "R-TRADE-06", "text": "3:1 mit Gebäude an einem 3:1-Hafen.", "ratio": 3, "requires": "building_on_generic_port_vertex" },
      { "id": "R-TRADE-07", "text": "2:1 nur für den abgebildeten Rohstoff mit Gebäude am Spezialhafen; kein 3:1 für andere Rohstoffe.", "ratio": 2, "requires": "building_on_matching_special_port_vertex" },
      { "id": "R-TRADE-08", "text": "Seehandel beliebig oft und in Vielfachen." }
    ],
    "port_vertices_per_port": 2,
    "maritime_receive": "any_other_resource",
    "sources": ["Q1", "Q2", "Q3", "Q4"]
  },

  "building": {
    "road": [
      { "id": "R-BUILD-01", "text": "Auf freiem Weg, max. 1 Straße pro Weg." },
      { "id": "R-BUILD-02", "text": "Muss an eigene Straße, Siedlung oder Stadt anschließen." },
      { "id": "R-BUILD-03", "text": "Nicht über eine Kreuzung mit fremdem Gebäude hinweg fortsetzen." }
    ],
    "settlement": [
      { "id": "R-BUILD-10", "text": "Freie Kreuzung mit mind. 1 angrenzender eigener Straße (außer Gründungsphase)." },
      { "id": "R-BUILD-11", "text": "Abstandsregel: keine benachbarte Kreuzung mit Siedlung/Stadt (egal welcher Farbe).", "min_edge_distance_to_any_building": 2 },
      { "id": "R-BUILD-12", "text": "Alle 5 Siedlungen verbaut → erst eine zur Stadt ausbauen." }
    ],
    "city": [
      { "id": "R-BUILD-20", "text": "Nur Ausbau einer eigenen Siedlung; Siedlung geht in den Vorrat zurück." },
      { "id": "R-BUILD-21", "text": "Straßen und Städte bleiben bis Spielende liegen." }
    ],
    "development_card": [
      { "id": "R-BUILD-30", "text": "Oberste Karte ziehen, geheim halten." },
      { "id": "R-BUILD-31", "text": "Leerer Stapel → kein Kauf; ausgespielte Karten kommen nicht zurück." }
    ],
    "sources": ["Q1", "Q3", "Q4"]
  },

  "development_cards": {
    "rules": [
      { "id": "R-DEV-01", "text": "Max. 1 Ritter- oder Fortschrittskarte pro Zug, jederzeit im eigenen Zug, auch vor dem Würfeln.", "max_per_turn": 1 },
      { "id": "R-DEV-02", "text": "Nicht im Kaufzug ausspielen." },
      { "id": "R-DEV-03", "text": "Siegpunktkarten: beliebig viele, auch im Kaufzug, nur zum Erreichen des Sieges aufdecken." },
      { "id": "R-DEV-04", "text": "Zählen nicht zum Handlimit bei 7, nicht raubbar." }
    ],
    "cards": {
      "knight":         { "name_de": "Ritter",     "count": 14, "effect": "move_robber_and_steal", "stays_face_up": true, "triggers_discard": false },
