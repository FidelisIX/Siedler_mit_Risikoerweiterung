  "special_cards": {
    "largest_army": {
      "name_de": "Größte Rittermacht",
      "vp": 2,
      "rules": [
        { "id": "R-ARMY-01", "text": "Erster mit 3 ausgespielten Rittern.", "min_knights": 3 },
        { "id": "R-ARMY-02", "text": "Wer mehr Ritter als der Besitzer hat, erhält sie sofort; Gleichstand: Besitzer behält.", "transfer": "strictly_more" }
      ]
    },
    "longest_road": {
      "name_de": "Längste Handelsstraße",
      "vp": 2,
      "rules": [
        { "id": "R-ROAD-01", "text": "Erster mit durchgehendem Straßenzug ≥ 5; gezählt wird der längste einfache Pfad, Abzweigungen zählen nicht.", "min_length": 5, "metric": "longest_simple_path_edges" },
        { "id": "R-ROAD-02", "text": "Längerer Straßenzug übernimmt sofort; Gleichstand: Besitzer behält.", "transfer": "strictly_longer" },
        { "id": "R-ROAD-03", "text": "Fremde Siedlung/Stadt auf einer Kreuzung unterbricht; eigene nicht.", "broken_by": "opponent_building_on_vertex" },
        { "id": "R-ROAD-04", "text": "Nach Unterbrechung: Besitzer (mit-)längster → behält; sonst bei Gleichstand mehrerer oder niemand ≥ 5 → beiseite legen, bis genau ein Spieler alleiniger Längster (≥ 5) ist.", "set_aside_conditions": ["holder_not_longest_and_tie", "no_road_ge_5"] }
      ]
    },
    "sources": ["Q1", "Q2", "Q3", "Q4"]
