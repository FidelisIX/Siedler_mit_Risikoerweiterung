  "setup": {
    "beginner_fixed_layout": {
      "id": "R-SETUP-01",
      "available": false,
      "note": "Nur als Abbildung in Q1/Q4; Koordinaten nicht übernommen (GAP-03)."
    },
    "rules": [
      { "id": "R-SETUP-02", "text": "Rahmenteile zufällig zusammensetzen (2015/2020: Hafenplättchen zufällig verteilen).", "sources": ["Q1", "Q2"] },
      { "id": "R-SETUP-03", "text": "Landfelder zufällig in den Rahmen legen.", "sources": ["Q1", "Q3"] },
      { "id": "R-SETUP-04", "text": "Zahlenchips in Buchstabenreihenfolge A–R ab einem Eckfeld gegen den Uhrzeigersinn spiralförmig zur Mitte legen, Wüste überspringen, dann umdrehen.", "sources": ["Q1", "Q2", "Q3"] },
      { "id": "R-SETUP-05", "text": "Alternative: vollständig zufällige Zahlen, aber 6 und 8 dürfen nicht auf benachbarten Feldern liegen.", "optional": true, "sources": ["Q2"] },
      { "id": "R-SETUP-06", "text": "Räuber startet auf der Wüste.", "sources": ["Q1", "Q3"] },
      { "id": "R-SETUP-07", "text": "Rohstoffkarten offen nach Sorte als Vorrat; Entwicklungskarten gemischt und verdeckt.", "sources": ["Q1", "Q3"] },
      { "id": "R-SETUP-08", "text": "Bei 3 Spielern wird eine Farbe nicht verwendet.", "sources": ["Q1", "Q4"] }
    ],
    "founding_phase": {
      "start_player": { "id": "R-SETUP-10", "method": "Jeder würfelt 2W6, höchste Summe beginnt.", "tie": "GAP-01", "sources": ["Q1", "Q3"] },
      "rounds": [
        { "id": "R-SETUP-11", "round": 1, "order": "clockwise_from_start_player", "place": ["settlement", "road_adjacent_to_that_settlement"] },
        { "id": "R-SETUP-12", "round": 2, "order": "counterclockwise_from_last_player", "place": ["settlement", "road_adjacent_to_that_settlement"], "note": "Startspieler setzt als Letzter; zweite Siedlung muss nicht mit der ersten verbunden sein." }
      ],
      "distance_rule_applies": { "id": "R-SETUP-13", "value": true },
      "road_connection_required_for_settlement": false,
      "starting_resources": { "id": "R-SETUP-14", "trigger": "second_settlement", "amount": "1 Karte je angrenzendem Landfeld (Wüste: 0)" },
      "first_turn": { "id": "R-SETUP-15", "player": "start_player" },
      "sources": ["Q1", "Q3"]
    }
  },

